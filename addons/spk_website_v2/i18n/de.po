msgstr "Verwenden Sie für Land oder Region höchstens 100 Zeichen."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid "Use 4,000 characters or fewer for the project details."
msgstr "Verwenden Sie für die Projektdetails höchstens 4.000 Zeichen."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid ""
"Enter a phone number using digits, spaces and + ( ) - only, up to 40 "
"characters."
msgstr ""
"Geben Sie eine Telefonnummer nur mit Ziffern, Leerzeichen und + ( ) - ein, "
"höchstens 40 Zeichen."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid "Choose one of the listed options."
msgstr "Wählen Sie eine der aufgeführten Optionen."

#. module: spk_website_v2
