#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid "Use 4,000 characters or fewer for the project details."
msgstr "Use un máximo de 4000 caracteres para los detalles del proyecto."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid ""
"Enter a phone number using digits, spaces and + ( ) - only, up to 40 "
"characters."
msgstr ""
"Introduzca un número de teléfono usando solo dígitos, espacios y + ( ) -, "
"con un máximo de 40 caracteres."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid "Choose one of the listed options."
msgstr "Elija una de las opciones de la lista."

#. module: spk_website_v2
#. odoo-python
#: code:addons/spk_website_v2/site_content.py:0
msgid "This form has expired. Reload the page and send it again."
msgstr ""
"Este formulario ha caducado. Vuelva a cargar la página y envíelo de nuevo."
