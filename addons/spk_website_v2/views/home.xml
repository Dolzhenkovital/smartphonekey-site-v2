<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The home page (brief of 30 October 2026, Claude Design direction A, DESIGN.md "Home
         opening"): the opening with the real Admin Panel Dashboard and the reader, three
         benefits, the journey from installation to entry, everyday situations with the real
         guest-key and activity screens, the Admin Panel AI Assistant, the reader and its
         connections, additional capabilities and the closing actions. The product screenshots
         are authentic captures of 30 October 2026 (static/src/img/product-ui, see
         tools/product_ui_images.py); the interface stays English in every language and the
         figures in it are interface values of a test account, never metrics. -->
    <template id="page_home" name="SmartphoneKey 2.0: home">
        <!-- The Dashboard image is the largest element of the first screen: eager and high priority,
             written out so that Odoo's post-processing does not add loading="lazy". -->
        <t t-call="spk_website_v2.layout">
            <t t-set="page_scripts">
                <script t-attf-src="/spk_website_v2/static/src/js/expand.js?v=#{v2_asset_version}" defer="defer"/>
            </t>

            <section class="container hero-opening" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <p class="kicker">Access management for buildings</p>
                    <h1 id="hero-title">Manage access across your properties in one place</h1>
                    <p class="lead">Give residents, staff and contractors access to the doors they need. Manage Wallet keys and cards, update permissions and see device activity in SmartphoneKey.</p>
                    <div class="actions">
                        <a class="button" href="/platform">Explore the platform</a>
                        <a class="text-link" href="/contact?interest=project">Discuss your project</a>
                    </div>
                </div>
                <figure class="hero-reader">
                    <img src="/spk_website_v2/static/src/img/reader-cutout-560.webp"
                         srcset="/spk_website_v2/static/src/img/reader-cutout-560.webp 270w, /spk_website_v2/static/src/img/reader-cutout-1120.webp 540w"
                         sizes="(max-width: 640px) 58px, 87px" width="270" height="560" loading="eager" decoding="async"
                         alt="SmartphoneKey reader: a black unit with the SmartphoneKey logo and a phone-with-key symbol on the front"/>
                    <figcaption>
                        <p class="cell-title">SmartphoneKey reader</p>
                        <p class="cell-text">Reader and access controller in one device. LTE, Wi-Fi or supported Thread connectivity.</p>
                    </figcaption>
                </figure>
                <figure class="screen-figure">
                    <div class="screen-frame">
                        <picture>
                            <source media="(max-width: 640px)" srcset="/spk_website_v2/static/src/img/product-ui/admin-dashboard-close-up-936.webp" width="936" height="840"/>
                            <img src="/spk_website_v2/static/src/img/product-ui/admin-dashboard-1200.webp"
                                 srcset="/spk_website_v2/static/src/img/product-ui/admin-dashboard-800.webp 800w, /spk_website_v2/static/src/img/product-ui/admin-dashboard-1200.webp 1200w, /spk_website_v2/static/src/img/product-ui/admin-dashboard-1600.webp 1600w, /spk_website_v2/static/src/img/product-ui/admin-dashboard-2133.webp 2133w"
                                 sizes="(max-width: 960px) calc(100vw - 64px), 1200px" width="2133" height="900" loading="eager" fetchpriority="high" decoding="async"
                                 alt="SmartphoneKey Admin Panel showing access actions, device and key summaries, and recent activity"/>
                        </picture>
                    </div>
                    <div class="screen-meta">
                        <figcaption class="screen-caption">Admin Panel Dashboard, English interface. The figures are interface values from a test account, not customer metrics.</figcaption>
                        <a class="button-outline expand-link" href="/spk_website_v2/static/src/img/product-ui/admin-dashboard-2133.webp" data-spk-expand="" data-spk-expand-alt="SmartphoneKey Admin Panel showing access actions, device and key summaries, and recent activity" data-spk-expand-width="2133" data-spk-expand-height="900">View larger</a>
                    </div>
                </figure>
            </section>

            <section class="section container" id="benefits" aria-labelledby="benefits-title">
                <h2 id="benefits-title" class="visually-hidden">What SmartphoneKey gives you</h2>
                <ul class="benefits" role="list">
                    <li>
                        <h3>Manage access centrally</h3>
                        <p>Add people, choose their doors and update access across your sites.</p>
                    </li>
                    <li>
                        <h3>Enter with a Wallet key or card</h3>
                        <p>Offer Apple Wallet and Google Wallet keys on supported devices, alongside physical NFC cards.</p>
                        <ul class="chips" role="list" aria-label="Ways to enter">
                            <li class="chip">Apple Wallet</li>
                            <li class="chip">Google Wallet</li>
                            <li class="chip">NFC card</li>
                        </ul>
                    </li>
                    <li>
                        <h3>Plan the connection for each door</h3>
                        <p>Combine readers with a built-in access controller and LTE, Wi-Fi or supported Thread connectivity.</p>
                    </li>
                </ul>
            </section>

            <section class="section container" id="journey" aria-labelledby="journey-title">
                <h2 id="journey-title">From installation to everyday access</h2>
                <ol class="journey" role="list">
                    <li>
                        <h3 class="step-heading">Install</h3>
                        <p class="step-text">An installer connects the reader, power and compatible lock hardware, then configures the connection.</p>
                        <figure class="step-media is-tinted">
                            <img src="/spk_website_v2/static/src/img/reader-cutout-560.webp"
                                 srcset="/spk_website_v2/static/src/img/reader-cutout-560.webp 270w, /spk_website_v2/static/src/img/reader-cutout-1120.webp 540w"
                                 sizes="110px" width="270" height="560" loading="lazy" decoding="async"
                                 alt="SmartphoneKey reader with backplate"/>
                            <figcaption class="photo-caption">SmartphoneKey reader, product image from the installation guide.</figcaption>
                        </figure>
                    </li>
                    <li>
                        <h3 class="step-heading">Grant access</h3>
                        <p class="step-text">An administrator selects the doors and assigns access to the right person.</p>
                        <figure class="step-media is-shot">
                            <img src="/spk_website_v2/static/src/img/product-ui/assign-access-dialog-548.webp" width="548" height="442" loading="lazy" decoding="async"
                                 alt="Assign Key wizard at the user-selection step, with an empty recipient field"/>
                            <figcaption class="photo-caption">Assign Key wizard, step 2 of 3, before a person is chosen. English interface.</figcaption>
                        </figure>
                    </li>
                    <li>
                        <h3 class="step-heading">Enter</h3>
                        <p class="step-text">The key holder uses a supported Wallet key or NFC card at an authorised door.</p>
                        <figure class="step-media is-tinted">
                            <ol class="enter-flow" role="list" aria-label="Ways to enter">
                                <li><span class="flow-name">Wallet key</span> <span class="flow-note">Apple Wallet or Google Wallet on a supported phone</span></li>
                                <li><span class="flow-name">NFC card</span> <span class="flow-note">a physical card</span></li>
                                <li class="flow-to"><span class="flow-name">SmartphoneKey reader</span> <span class="flow-note">checks the key or card</span></li>
                                <li class="flow-to"><span class="flow-name">Authorised door</span></li>
                            </ol>
                            <figcaption class="photo-caption">Ways to enter, not a product screen.</figcaption>
                        </figure>
                    </li>
                </ol>
                <p class="links">
                    <a href="/platform">See how the platform works</a>
                </p>
            </section>

            <section class="section container" id="situations" aria-labelledby="situations-title">
                <div class="split-evidence">
                    <div class="split-copy">
                        <h2 id="situations-title">Access that changes with your building</h2>
                        <dl class="cases">
                            <div>
                                <dt>A new resident moves in</dt>
                                <dd>Assign a card or supported digital key for their doors and shared areas.</dd>
                            </div>
                            <div>
                                <dt>A contractor is visiting</dt>
                                <dd>Set a validity period for supported guest access.</dd>
                            </div>
                            <div>
                                <dt>An employee needs another door</dt>
                                <dd>Update their permissions as responsibilities change.</dd>
                            </div>
                            <div>
                                <dt>Someone leaves</dt>
                                <dd>Revoke their access and check that the readers have applied the change.</dd>
                            </div>
                        </dl>
                        <p class="note">Changes for an offline reader remain pending until it reconnects and applies them.</p>
                    </div>
                    <div class="evidence-stack">
                        <figure class="shot-figure">
                            <div class="shot">
                                <img src="/spk_website_v2/static/src/img/product-ui/guest-wallet-key-dialog-548.webp" width="548" height="632" loading="lazy" decoding="async"
                                     alt="Guest Wallet Key form with lock selection, validity dates and an empty email-recipient field"/>
                            </div>
                            <figcaption>Guest Key form in Wallet Key mode: validity dates and the recipient field, shown before anything is sent. English interface.</figcaption>
                        </figure>
                        <figure class="shot-figure">
                            <div class="shot">
                                <img src="/spk_website_v2/static/src/img/product-ui/recent-activity-close-up-620.webp" width="620" height="378" loading="lazy" decoding="async"
                                     alt="Recent activity showing lock and key events in the SmartphoneKey Admin Panel"/>
                            </div>
                            <figcaption>Recent activity in the Dashboard. An event is a record, not proof that a person passed through.</figcaption>
                        </figure>
                    </div>
                </div>
            </section>

            <section class="section container" id="assistant" aria-labelledby="assistant-title">
                <div class="split-evidence is-centred">
                    <div class="split-copy">
                        <h2 id="assistant-title">Help inside the Admin Panel</h2>
                        <p class="lead">Get help in the Admin Panel with the built-in AI Assistant. Available actions depend on your permissions and site configuration.</p>
                        <p class="links">
                            <a href="/platform/access-management">Explore access management</a>
                        </p>
                    </div>
                    <figure class="shot-figure">
                        <div class="assistant-panel">
                            <img src="/spk_website_v2/static/src/img/product-ui/ai-assistant-detail-422.webp" width="422" height="567" loading="lazy" decoding="async"
                                 alt="Built-in SmartphoneKey AI Assistant with its welcome message and message field"/>
                        </div>
                        <figcaption>The AI Assistant panel as it opens, English interface, before any message is sent.</figcaption>
                    </figure>
                </div>
            </section>

            <section class="section container" id="readers" aria-labelledby="reader-title">
                <div class="split-evidence is-reverse">
                    <div class="split-copy">
                        <h2 id="reader-title">A reader and access controller in one device</h2>
                        <p>Choose connectivity to suit the building. SmartphoneKey readers can use LTE or Wi-Fi, and can participate in a Thread mesh with a connected reader providing internet access.</p>
                        <p class="benefit">A suitable wireless design can reduce communication cabling between readers.</p>
                        <p class="note">Power, compatible lock hardware and local wiring are still required. Network layout and coverage depend on the installation.</p>
                        <p class="links">
                            <a href="/products/readers#compare">Compare reader connections</a>
                            <a href="/compatibility">Check compatibility</a>
                            <a class="is-quiet" href="/guide-for-usage-and-installation">Installation and connection guide</a>
                        </p>
                    </div>
                    <figure class="infra-panel">
                        <img src="/spk_website_v2/static/src/img/reader-cutout-560.webp"
                             srcset="/spk_website_v2/static/src/img/reader-cutout-560.webp 270w, /spk_website_v2/static/src/img/reader-cutout-1120.webp 540w"
                             sizes="106px" width="270" height="560" loading="lazy" decoding="async"
                             alt="SmartphoneKey reader"/>
                        <t t-call="spk_website_v2.connection_example"/>
                    </figure>
                </div>
            </section>

            <section class="section container" id="capabilities" aria-labelledby="capabilities-title">
                <h2 id="capabilities-title">Add the capabilities your site needs</h2>
                <p class="section-lead">Bring supported services and devices into the same platform, according to your site's configuration.</p>
                <dl class="caps">
                    <div>
                        <dt>Visitor contact</dt>
                        <dd>Visitors scan the entrance QR code to reach a resident or the site team.</dd>
                    </div>
                    <div>
                        <dt>Supported cameras and alerts</dt>
                        <dd>Manage supported cameras and configure alerts for device events.</dd>
                    </div>
                    <div>
                        <dt>Connected-device scenarios</dt>
                        <dd>Rules for supported Matter devices, each on one hub.</dd>
                    </div>
                    <div>
                        <dt>Card programming on supported readers</dt>
                        <dd>MIFARE Classic and MIFARE DESFire EV3 cards.</dd>
                    </div>
                </dl>
                <p class="links">
                    <a href="/platform/visitor-access">Visitor access</a>
                    <a href="/platform/automation">Scenarios for connected devices</a>
                    <a href="/compatibility">Check compatibility</a>
                </p>
            </section>

            <section class="section container next-steps" id="plan" aria-labelledby="next-title">
                <h2 id="next-title">Plan access for your property</h2>
                <p>Explore the platform, check your installation requirements or discuss your project with our team.</p>
                <div class="next-actions">
                    <a class="button" href="/contact?interest=project">Discuss your project</a>
                    <a class="text-link" href="/find-your-setup">Site recommendations</a>
                    <a class="text-link" href="/compatibility">Check compatibility</a>
                </div>
                <p class="partner-route">Installer or integrator? <a href="/solutions/integrators">How partners work with SmartphoneKey</a></p>
            </section>
        </t>
    </template>
</odoo>
