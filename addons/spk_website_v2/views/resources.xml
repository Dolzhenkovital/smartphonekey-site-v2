<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Resources: the index (buyer guides, instructions, insights), and one
         article template for the buyer guides (/resources/<slug>) and the
         archived blog articles (/post/<slug>). -->

    <template id="page_resources" name="SmartphoneKey 2.0: resources">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <t t-call="spk_website_v2.page_intro">
                    <t t-set="heading">Guides and instructions</t>
                    <t t-set="intro">Guides answer planning questions such as which connection to choose. Instructions cover installing readers and using the Admin Panel and the SmartphoneKey app.</t>
                    <t t-set="actions">
                        <div class="actions">
                            <a class="button" href="/find-your-setup">Site recommendations</a>
                            <a href="/guide-for-usage-and-installation">Installation and connection guide</a>
                        </div>
                    </t>
                </t>
                <nav class="contents" aria-label="On this page">
                    <ul>
                        <li><a href="#guides">Guides</a></li>
                        <li><a href="#instructions">Instructions</a></li>
                        <li><a href="#insights">Article archive</a></li>
                    </ul>
                </nav>
            </div>

            <section class="section container" id="guides" aria-labelledby="guides-title">
                <h2 id="guides-title">Guides</h2>
                <div class="resource-groups">
                    <div t-foreach="guide_groups" t-as="group" class="resource-group">
                        <h3 t-out="group[1]"/>
                        <ul>
                            <li t-foreach="group[2]" t-as="guide">
                                <a t-att-href="guide['path']" t-out="guide['name']"/>
                                <span class="muted" t-out="guide['description']"/>
                            </li>
                            <t t-if="group[0] == 'getting_started'">
                                <li><a href="/find-your-setup">Site recommendations</a><span class="muted">Recommendations for your sites, doors and connection, with the checks still to do on site.</span></li>
                            </t>
                            <t t-if="group[0] == 'cards_devices'">
                                <li><a href="/compatibility">Card and device compatibility</a><span class="muted">Which cards can be programmed, what digital keys need, Matter capabilities and reader network roles.</span></li>
                            </t>
                            <t t-if="group[0] == 'networks_automation'">
                                <li><a href="/platform/automation">Scenarios for connected devices</a><span class="muted">Example scenarios and the device capabilities they need.</span></li>
                            </t>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="section container" id="instructions" aria-labelledby="instructions-title">
                <h2 id="instructions-title">Instructions</h2>
                <t t-set="instruction" t-value="content.INSTRUCTION_PATHS"/>
                <ul class="instruction-list">
                    <li>
                        <a href="/guide-for-usage-and-installation" t-out="instruction['/guide-for-usage-and-installation']"/>
                        <span class="muted">Package contents, wiring, network setup and reader specifications.</span>
                    </li>
                    <li>
                        <a href="/instructions/admin-guide" t-out="instruction['/instructions/admin-guide']"/>
                        <span class="muted">Each Admin Panel screen, step by step.</span>
                    </li>
                    <li>
                        <a href="/instructions/admin-panel" t-out="instruction['/instructions/admin-panel']"/>
                        <span class="muted">A guided tour of the Admin Panel.</span>
                    </li>
                    <li>
                        <a href="/instructions/mobile-app-guide" t-out="instruction['/instructions/mobile-app-guide']"/>
                        <span class="muted">How to use the SmartphoneKey app.</span>
                    </li>
                    <li>
                        <a href="/instructions/mobile-app" t-out="instruction['/instructions/mobile-app']"/>
                        <span class="muted">A guided tour of the SmartphoneKey app.</span>
                    </li>
                    <li>
                        <a href="/apps-and-chatbot">SmartphoneKey apps</a>
                        <span class="muted">Download the app for Android and iPhone, and open the SmartphoneKey app in ChatGPT.</span>
                    </li>
                    <li>
                        <a href="/certifications">Certifications and documents</a>
                        <span class="muted">Regulatory records, conformity documents and certificates for the readers.</span>
                    </li>
                </ul>
            </section>

            <section class="section container" id="insights" aria-labelledby="insights-title">
                <div class="section-head">
                    <h2 id="insights-title">Article archive</h2>
                    <p>Articles from our earlier blog, kept in English with their original dates. They describe the product as it was presented then; for current facts, see the platform and compatibility pages.</p>
                </div>
                <ul class="article-list">
                    <li t-foreach="posts" t-as="post">
                        <a t-att-href="post['path']" t-att-hreflang="'en'" t-out="post['name']"/>
                        <span class="muted">Published <t t-out="format_day(post['published_on'])"/></span>
                    </li>
                </ul>
            </section>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Help with an installed system</t>
                <t t-set="next_text">Sign in to the Admin Panel, or email us with the site and reader details. Do not send passwords or access codes.</t>
                <a href="/adminpanel">Admin Panel</a>
                <a t-attf-href="mailto:#{contact_email}" t-out="contact_email"/>
                <a href="/contact?interest=project">Discuss a new project</a>
            </t>
        </t>
    </template>

    <template id="page_article" name="SmartphoneKey 2.0: article">
        <t t-call="spk_website_v2.layout">
            <article class="container spk-document" aria-labelledby="article-title">
                <div class="page-opening">
                    <t t-call="spk_website_v2.breadcrumbs"/>
                    <div class="opening-copy">
                        <h1 id="article-title" t-out="resource['name']"/>
                        <div class="meta">
                            <t t-if="resource['kind'] == 'guide'">
                                <p>By the SmartphoneKey product team</p>
                                <p>Published <t t-out="format_day(resource['published_on'])"/></p>
                                <p t-if="resource['modified_on']">Updated <t t-out="format_day(resource['modified_on'])"/></p>
                                <p t-if="resource['reviewed_on']">Product facts checked <t t-out="format_day(resource['reviewed_on'])"/></p>
                            </t>
                            <t t-else="">
                                <p>By <t t-out="resource['author_name']"/></p>
                                <p>Published <t t-out="format_day(resource['published_on'])"/></p>
                            </t>
                        </div>
                        <p t-if="resource['kind'] == 'post'" class="archive-note">This article is from our earlier blog and describes the product as it was presented then. For current facts, see <a href="/platform">How SmartphoneKey works</a> and <a href="/compatibility">Check compatibility</a>.</p>
                        <p t-if="resource['direct_answer'] and resource['kind'] == 'guide'" class="lead answer" t-out="resource['direct_answer']"/>
                    </div>
                </div>
                <figure t-if="resource['hero_image']" class="article-image">
                    <img t-att-src="resource['hero_image']" t-att-alt="resource['hero_alt'] or ''" decoding="async"/>
                </figure>
                <nav t-if="len(resource['contents']) &gt;= 3" class="contents" aria-label="On this page">
                    <p class="contents-title">On this page</p>
                    <ul>
                        <li t-foreach="resource['contents']" t-as="entry"><a t-att-href="'#' + entry[0]" t-out="entry[1]"/></li>
                    </ul>
                </nav>
                <div class="spk-prose" t-att-lang="'en' if resource['kind'] == 'post' else None" t-out="resource['body']"/>
                <section t-if="resource['sources']" class="references" aria-labelledby="references-title">
                    <h2 id="references-title">References</h2>
                    <ul>
                        <li t-foreach="resource['sources']" t-as="source"><a t-att-href="source[1]" rel="noopener" t-out="source[0]"/></li>
                    </ul>
                </section>
            </article>

            <t t-if="resource['related']" t-call="spk_website_v2.related_links">
                <t t-set="related_title">Related pages</t>
                <li t-foreach="resource['related']" t-as="link"><a t-att-href="link[1]" t-out="t(link[0])"/></li>
            </t>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Plan your installation</t>
                <t t-set="next_text" t-value="False"/>
                <a href="/find-your-setup">Site recommendations</a>
                <a href="/compatibility">Check compatibility</a>
                <a href="/contact?interest=project">Discuss your project</a>
            </t>
        </t>
    </template>
</odoo>
