<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- About, team, security and trust, certifications, apps and the 404 page. -->

    <template id="page_about" name="SmartphoneKey 2.0: about">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <t t-call="spk_website_v2.page_intro">
                    <t t-set="heading">The team behind SmartphoneKey</t>
                    <t t-set="intro">We build SmartphoneKey: the Admin Panel where teams manage access to their sites, and the readers, cards and digital keys used at the door.</t>
                </t>
            </div>

            <section t-if="team" class="section container" aria-labelledby="team-title">
                <h2 id="team-title">The team</h2>
                <ul class="team-list">
                    <li t-foreach="team" t-as="member">
                        <img t-if="member['photo']" t-att-src="member['photo']" alt="" width="160" height="173" loading="lazy" decoding="async"/>
                        <a t-att-href="'/team/' + member['slug']" t-out="member['name']"/>
                        <span class="muted" t-out="member['job_title']"/>
                        <span t-if="member['is_advisor']" class="muted">Advisor</span>
                    </li>
                </ul>
            </section>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">See what we build</t>
                <t t-set="next_text" t-value="False"/>
                <a class="button" href="/platform">Explore the platform</a>
                <a href="/contact">Contact the team</a>
            </t>
        </t>
    </template>

    <template id="page_team_member" name="SmartphoneKey 2.0: team member">
        <t t-call="spk_website_v2.layout">
            <article class="container spk-document team-member" aria-labelledby="member-name">
                <div class="page-opening">
                    <t t-call="spk_website_v2.breadcrumbs"/>
                    <div class="opening-copy">
                        <h1 id="member-name" t-out="member['name']"/>
                        <p class="lead" t-out="member['job_title']"/>
                    </div>
                </div>
                <div class="member-body">
                    <img t-if="member['photo']" t-att-src="member['photo']" t-att-alt="member['photo_alt'] or ''" width="480" height="519" decoding="async"/>
                    <div class="spk-prose">
                        <t t-out="member['bio']"/>
                        <p t-if="member['linkedin_url']"><a t-att-href="member['linkedin_url']" rel="noopener">LinkedIn profile</a></p>
                    </div>
                </div>
            </article>
            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Meet the rest of the team</t>
                <t t-set="next_text" t-value="False"/>
                <a href="/about">About SmartphoneKey</a>
                <a href="/contact">Contact</a>
            </t>
        </t>
    </template>

    <template id="page_security" name="SmartphoneKey 2.0: security and trust">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <t t-call="spk_website_v2.page_intro">
                    <t t-set="heading">Assess the security of your installation</t>
                    <t t-set="intro">Security depends on the whole installation: who can change access, the readers and their network, and how the site is operated. Here is what SmartphoneKey controls and shows, and which documents to check.</t>
                    <t t-set="actions">
                        <div class="actions">
                            <a class="button" href="/contact?interest=technical">Discuss technical requirements</a>
                            <a href="/certifications">View certifications</a>
                        </div>
                    </t>
                </t>
            </div>

            <section class="section container" aria-labelledby="controls-title">
                <h2 id="controls-title" class="visually-hidden">Controls</h2>
                <div class="columns-2">
                    <div>
                        <h3>Permissions by site</h3>
                        <p>Administrators work only on the sites they are given. What each person can see and do follows their permissions and the services configured for the account.</p>
                    </div>
                    <div>
                        <h3>Changes you can check</h3>
                        <p>Events and change status show whether a change was requested, confirmed by the reader or failed. A change waiting for an offline reader is not yet in effect there.</p>
                    </div>
                    <div>
                        <h3>Devices and networks</h3>
                        <p>Check the capabilities and network roles of each device. A working connection does not certify the whole installation, and alerts are not a response-time guarantee.</p>
                    </div>
                    <div>
                        <h3>Product documents</h3>
                        <p>Open the regulatory records and certificates for the readers. Each document applies only to the model and scope it names.</p>
                        <a href="/certifications">View certifications</a>
                    </div>
                </div>
            </section>

            <section class="section container split" aria-labelledby="procurement-title">
                <h2 id="procurement-title">Questions for procurement</h2>
                <div class="split-copy">
                    <p>Ask about the deployment architecture, responsibilities, data retention, access permissions and the documents your project requires. We answer for your configuration rather than assume one setup fits every requirement.</p>
                </div>
            </section>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Discuss your security requirements</t>
                <t t-set="next_text" t-value="False"/>
                <a class="button" href="/contact?interest=technical">Discuss technical requirements</a>
                <a href="/certifications">View certifications</a>
                <a href="/guide-for-usage-and-installation">Installation and connection guide</a>
            </t>
        </t>
    </template>

    <!-- Document links only (claim C20): what each document states, no badges. -->
    <template id="page_certifications" name="SmartphoneKey 2.0: certifications">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <t t-call="spk_website_v2.page_intro">
                    <t t-set="heading">Certifications and documents</t>
                    <t t-set="intro">Regulatory records, conformity documents and platform certificates for SmartphoneKey readers. Each applies only to the model, version and scope it names; check these before you rely on a document for your project.</t>
                </t>
            </div>

            <section class="section container" aria-labelledby="records-title">
                <h2 id="records-title">Regulatory records</h2>
                <div class="spk-table" role="region" tabindex="0" aria-label="Regulatory records">
                    <table>
                        <caption>Regulatory records</caption>
                        <thead>
                            <tr><th scope="col">Record</th><th scope="col">Identifier</th><th scope="col">Product as listed</th><th scope="col">Source</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">FCC equipment authorization (United States)</th>
                                <td>FCC ID 2BNRNSPKRDRWV1</td>
                                <td>Wi-Fi, Bluetooth and NFC reader, model SPKRDRWV1</td>
                                <td><a href="https://fccid.io/2BNRNSPKRDRWV1" rel="noopener">FCC record</a></td>
                            </tr>
                            <tr>
                                <th scope="row">FCC equipment authorization (United States)</th>
                                <td>FCC ID 2BNRNSPKRDRLV1</td>
                                <td>LTE and NFC reader, model SPKRDRLV1</td>
                                <td><a href="https://fccid.io/2BNRNSPKRDRLV1" rel="noopener">FCC record</a></td>
                            </tr>
                            <tr>
                                <th scope="row">ISED radio equipment registration (Canada)</th>
                                <td>IC 35944-SPKRDRWV1</td>
                                <td>SmartphoneKey Wi-Fi reader</td>
                                <td>Canadian radio equipment list</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="section container" aria-labelledby="documents-title">
                <h2 id="documents-title">Certificates and conformity documents</h2>
                <div class="spk-table" role="region" tabindex="0" aria-label="Product documents">
                    <table>
                        <caption>Product documents</caption>
                        <thead>
                            <tr><th scope="col">Document</th><th scope="col">Issued by</th><th scope="col">What it states</th><th scope="col">File</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Certificate of RED compliance, Directive 2014/53/EU (ref. AiTDG-260511001-C01)</th>
                                <td>Dongguan Yaxu (AiT) Technology Limited</td>
                                <td>A voluntary assessment of the SmartphoneKey Wi-Fi reader configuration. The document states it is based on the evaluation of one sample.</td>
                                <td><a href="/spk_website_v2/static/src/files/ce-red-wifi-reader-spk-ac-wifi-v1-0.pdf">PDF</a></td>
                            </tr>
                            <tr>
                                <th scope="row">Verification of conformity, Radio Equipment Directive 2014/53/EU (certificate LGT25A078C01)</th>
                                <td>Shenzhen LGT Test Service Co., Ltd., 14 March 2025</td>
                                <td>SmartphoneKey Reader, model SPK_AC_LTE_EU_V1.0, tested against the standards listed in the document.</td>
                                <td><a href="/spk_website_v2/static/src/files/ce-red-lte-reader-spk-ac-lte-eu-v1-0.pdf">PDF</a></td>
                            </tr>
                            <tr>
                                <th scope="row">Smart Tap 2.1 compliance certificate</th>
                                <td>Google Wallet Passes Support, 22 May 2025</td>
                                <td>Hardware models SPK_AC_LTE_EU_V1.0, SPK_AC_LTE_US_V1.0 and SPK_AC_WIFI_V1.0 with application software 02.02.00, approved for value-added services only, not payment.</td>
                                <td><a href="/spk_website_v2/static/src/files/google-smart-tap-2-1-compliance-certificate.jpeg">Image</a></td>
                            </tr>
                            <tr>
                                <th scope="row">Apple ECP2 certification confirmation</th>
                                <td>SmartphoneKey (company document), 14 April 2025</td>
                                <td>States that the SmartphoneKey Reader completed Apple ECP2 certification for Apple Wallet (product plan 820066-810568).</td>
                                <td><a href="/spk_website_v2/static/src/files/apple-ecp2-certification-confirmation.docx">Word document</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="section-note">Need a document that is not listed, or a check against your project's requirements? Ask us and we will tell you what applies to the exact model.</p>
            </section>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Assess the whole installation</t>
                <t t-set="next_text">A document covers a product. Your project also depends on permissions, keys and cards, networks and how the site is operated.</t>
                <a href="/security">Security and trust</a>
                <a href="/guide-for-usage-and-installation">Installation and connection guide</a>
                <a href="/contact?interest=technical">Discuss technical requirements</a>
            </t>
        </t>
    </template>

    <template id="page_apps" name="SmartphoneKey 2.0: apps">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <t t-call="spk_website_v2.page_intro">
                    <t t-set="heading">SmartphoneKey apps</t>
                    <t t-set="intro">The SmartphoneKey app for Android and iPhone, and the SmartphoneKey app in ChatGPT. What you can do in each depends on your account and its permissions.</t>
                </t>
            </div>

            <section class="section container" aria-labelledby="apps-title">
                <h2 id="apps-title" class="visually-hidden">Download</h2>
                <div class="columns-3">
                    <div>
                        <h3>Android</h3>
                        <p>Manage your keys and access from an Android phone or tablet.</p>
                        <a href="https://play.google.com/store/apps/details?id=com.smartphonekey.mobileapp&amp;hl=en" rel="noopener">Get it on Google Play</a>
                    </div>
                    <div>
                        <h3>iPhone</h3>
                        <p>Manage your keys and access from an iPhone, including supported Wallet keys.</p>
                        <a href="https://apps.apple.com/ca/app/smartphonekey/id6736495951" rel="noopener">Download on the App Store</a>
                    </div>
                    <div>
                        <h3>ChatGPT</h3>
                        <p>Use the SmartphoneKey app inside ChatGPT. The actions available depend on your account.</p>
                        <a href="https://chatgpt.com/apps/smartphonekey/asdk_app_69e95d545bb48191985e5873db121d5b" rel="noopener">Open in ChatGPT</a>
                    </div>
                </div>
            </section>

            <t t-call="spk_website_v2.next_step">
                <t t-set="next_title">Learn the app</t>
                <t t-set="next_text" t-value="False"/>
                <a href="/instructions/mobile-app-guide">Mobile app user guide</a>
                <a href="/instructions/mobile-app">Mobile app walkthrough</a>
            </t>
        </t>
    </template>

    <template id="page_404" name="SmartphoneKey 2.0: not found">
        <t t-call="spk_website_v2.layout">
            <div class="container">
                <div class="page-opening">
                    <div class="opening-copy">
                        <h1>This page is not here.</h1>
                        <p class="lead">The address may be mistyped, or the page may have moved.</p>
                        <div class="next-actions">
                            <a href="/">Home</a>
                            <a href="/platform">Platform</a>
                            <a href="/resources">Resources</a>
                            <a href="/contact">Contact</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
