<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared pieces. Text that pages pass in is written as markup in the
         t-call body (never as Python strings), so it is translated with the page. -->

    <!-- The LTE / Wi-Fi comparison table: the one source for /products/readers and the
         LTE vs Wi-Fi guide (rendering.BODY_COMPONENTS). Only the differences: what both
         readers share is written next to the table on each page. -->
    <template id="reader_comparison" name="SmartphoneKey 2.0: reader comparison">
        <div class="spk-table" role="region" tabindex="0" aria-label="How the LTE and Wi-Fi readers differ">
            <table>
                <caption>How the LTE and Wi-Fi readers differ</caption>
                <thead>
                    <tr><th scope="col">What differs</th><th scope="col">LTE reader</th><th scope="col">Wi-Fi reader</th></tr>
                </thead>
                <tbody>
                    <tr><th scope="row">Connection</th><td>Cellular network (LTE)</td><td>The site's Wi-Fi network</td></tr>
                    <tr><th scope="row">Check at each door</th><td>Cellular coverage at the reader position</td><td>Wi-Fi coverage at the reader position</td></tr>
                    <tr><th scope="row">You provide</th><td>A SIM and cellular service for each reader</td><td>Network access details and the settings in the installation guide</td></tr>
                    <tr><th scope="row">Suits</th><td>Doors with reliable cellular coverage, or sites where the local network cannot be used</td><td>Doors with reliable Wi-Fi on a network you can configure</td></tr>
                    <tr><th scope="row">To keep it working</th><td>Keep the SIM service active</td><td>Plan for changes to the network name, password or equipment</td></tr>
                </tbody>
            </table>
        </div>
    </template>

    <!-- Questions and answers, always in the page (never loaded on demand).
         Body: one <div class="faq-item"> per question. -->
    <template id="faq" name="SmartphoneKey 2.0: questions">
        <section class="section container faq" aria-labelledby="faq-title">
            <h2 id="faq-title">Questions</h2>
            <div class="faq-list">
                <t t-out="0"/>
            </div>
        </section>
    </template>

    <!-- The closing section of a page. next_title and next_text are set in the
         body; the rest of the body is the actions (at most one .button). -->
    <template id="next_step" name="SmartphoneKey 2.0: next step">
        <section class="section container next-steps" aria-labelledby="next-title">
            <h2 id="next-title" t-out="next_title"/>
            <p t-if="next_text" t-out="next_text"/>
            <div class="next-actions">
                <t t-out="0"/>
            </div>
        </section>
    </template>

    <!-- A labelled example of how readers can share a connection (claims C13, C14): one
         reader with LTE or Wi-Fi reaches the internet, the others join it over the Thread
         mesh. An example, never a specification: no distance, node count or failover. Used
         on the home page and the readers page. -->
    <template id="connection_example" name="SmartphoneKey 2.0: connection example">
        <div class="connection-example">
            <p class="illustration-label">Example connection layout</p>
            <ol class="connection-nodes" role="list">
                <li class="is-uplink"><span class="node-name">Reader at the main entrance</span> <span class="node-note">LTE or Wi-Fi, connected to the internet</span></li>
                <li><span class="node-name">Reader at the side door</span> <span class="node-note">Thread mesh</span></li>
                <li><span class="node-name">Reader at the bike store</span> <span class="node-note">Thread mesh</span></li>
            </ol>
            <p class="photo-caption">An example, not a specification. Coverage, the number of readers and the route to the internet depend on the installation.</p>
        </div>
    </template>

    <!-- Related pages as a ruled list. related_title is set in the body; the
         rest of the body is the <li> items. -->
    <template id="related_links" name="SmartphoneKey 2.0: related pages">
        <nav class="section container related" aria-labelledby="related-title">
            <h2 id="related-title" class="related-title" t-out="related_title"/>
            <ul class="next-links" role="list">
                <t t-out="0"/>
            </ul>
        </nav>
    </template>
</odoo>
